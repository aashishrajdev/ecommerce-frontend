# API Configuration
API_BASE_URL=https://api.example.com/v1

# Authentication
AUTH_API_KEY=your_auth_api_key_here
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=24h

# Payment Gateway (for checkout)
STRIPE_PUBLIC_KEY=your_stripe_public_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Analytics
GOOGLE_ANALYTICS_ID=your_ga_id_here
FACEBOOK_PIXEL_ID=your_fb_pixel_id_here

# Email Service
EMAIL_SERVICE_API_KEY=your_email_service_key_here
EMAIL_FROM_ADDRESS=noreply@example.com

# CDN Configuration (for product images)
CDN_BASE_URL=https://cdn.example.com
CDN_API_KEY=your_cdn_api_key_here

# Search Service
ALGOLIA_APP_ID=your_algolia_app_id_here
ALGOLIA_SEARCH_KEY=your_algolia_search_key_here
ALGOLIA_ADMIN_KEY=your_algolia_admin_key_here

# Maps and Location
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Social Media
FACEBOOK_APP_ID=your_fb_app_id_here
GOOGLE_CLIENT_ID=your_google_client_id_here

# Cache Configuration
CACHE_TTL=3600
CACHE_ENABLED=true

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_SOCIAL_LOGIN=true
ENABLE_PUSH_NOTIFICATIONS=false

# Environment
NODE_ENV=development
DEBUG=false 